{
  "name": "apex-ai-desktop",
  "version": "0.3.6",
  "private": true,
  "description": "Apex AI 0.3.5.1: ACC gear display and clearer 75 Hz recording diagnostics",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --x64 --publish never",
    "test": "node --test tests/*.test.cjs"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "jsdom": "26.1.0"
  },
  "build": {
    "appId": "pl.apexai.raceengineer",
    "productName": "Apex AI",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "session-library.cjs",
      "preferences.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "ui",
        "to": "ui"
      },
      {
        "from": "collector/publish",
        "to": "collector"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Apex AI",
      "perMachine": false,
      "artifactName": "ApexAI-Setup-0.3.5.1-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "ApexAI-Portable-0.3.5.1-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "sergiosochanskiracingpoland-dotcom",
        "repo": "apex-ai"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
