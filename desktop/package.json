{
  "name": "apex-ai-desktop",
  "version": "0.3.1",
  "private": true,
  "description": "Apex AI ACC desktop with integrated .NET collector and automatic updates",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "pl.apexai.raceengineer",
    "productName": "Apex AI",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "bridge.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../archive/0.2.15/index.html",
        "to": "dashboard/index.html"
      },
      {
        "from": "bridge.js",
        "to": "dashboard/bridge.js"
      },
      {
        "from": "collector/publish",
        "to": "collector"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Apex AI",
      "perMachine": false,
      "artifactName": "ApexAI-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "ApexAI-Portable-${version}-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "sergiosochanskiracingpoland-dotcom",
        "repo": "apex-ai"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
